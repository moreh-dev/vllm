ARG TARGET=default

FROM vllm/vllm-openai:v0.13.0 AS base_default
FROM rocm/vllm:v0.14.0_amd_dev AS base_mi250

# Select the proper base image; TARGET must be lowercase to satisfy Docker's
# repository/name rules (e.g., TARGET=mi250).
FROM base_${TARGET} AS base
ARG TARGET

RUN apt-get update && apt-get install -y git
RUN pip uninstall -y vllm
RUN pip install wandb

RUN git clone https://github.com/moreh-dev/vllm.git /root/vllm
WORKDIR /root/vllm
RUN git checkout dump-hidden-states
RUN target_lower=$(printf '%s' \"$TARGET\" | tr '[:upper:]' '[:lower:]') && \
    if [ \"$target_lower\" = \"mi250\" ]; then \
      export PYTORCH_ROCM_ARCH=\"gfx90a\" && python3 setup.py develop; \
    else \
      VLLM_PRECOMPILED_WHEEL_COMMIT=4fd9d6a85c00ac0186aa9abbeff73fc2ac6c721e VLLM_USE_PRECOMPILED=1 pip install --editable .; \
    fi

ENTRYPOINT ["/bin/bash"]
